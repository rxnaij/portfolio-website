---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../layouts/PageHeader.astro';
import WideSection from '../layouts/WideSection.astro';
import { Title } from '../components/typography/typography';
import { Github, Behance, Globe, Controller, CloudMoonFill, FileMusicFill } from 'react-bootstrap-icons';
import AboutBio from '../data/about-me.md';
import moduleStyles from './about.module.scss';

const { bioWrapper, asideContent, links, interests, title } = moduleStyles;
---

<Layout title="About me">
	<PageHeader>
		<h1>About me</h1>
		<p>What's up!</p>
	</PageHeader>
	<section class={bioWrapper}>
		<div class="main longform-text">
			<AboutBio />
		</div>
	</section>
	<WideSection as="aside" class={asideContent}>
		<Title title="Across the internet" level={2} />
		<div>
			<h3>Relevant links</h3>
			<div class={links}>
				<div>
					<a class={title} href="https://be.net/richardbludesign">Behance <Behance size={20} /></a>
					<p>UI and visual design work.</p>
				</div>
				<div>
					<a class={title} href="https://github.com/rxnaij">GitHub <Github size={20} /></a>
					<p>Code.</p>
				</div>
				<div>
					<a class={title} href="https://kind-lumiere-cbb8a1.netlify.app/">Super Save Slot <Globe size={20} /></a>
					<p>Video game blog: reviews, thoughts, and critique.</p>
				</div>
			</div>
		</div>
		<div>
			<h3>Current interests</h3>
			<div class={interests}>
				<div>
					<p class={title}>Now playing <Controller size={20} style={{ display: 'inline-block' }} /></p>
					<ul>
						<li>Yakuza: Like a Dragon</li>
						<li>Fire Emblem Warriors: Three Hopes</li>
						<li>Metroid Dread</li>
					</ul>
				</div>
				<div>
					<p class={title}>On deck <CloudMoonFill size={20} style={{ display: 'inline-block' }} /></p>
					<ul>
						<li>Live A Live</li>
						<li>Dragon Quest XI: Echoes of an Elusive Age</li>
						<li>SteamWorld Dig 2 (3DS)</li>
					</ul>
				</div>
				<div>
					<p class={title}>Music <FileMusicFill size={20} style={{ display: 'inline-block' }} /></p>
					<p>
						In <strong>love</strong> with <a href="https://open.spotify.com/album/4pJT0WKggr4xk149X8A6KC?si=_8sWFb-4Tqm4iajYh3Yu2g">Persona 5's soundtrack</a>, and trying to learn its songs on guitar!
					</p>
				</div>
			</div>
		</div>
	</WideSection>
</Layout>
