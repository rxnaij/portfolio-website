---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PageHeader from '../layouts/PageHeader.astro';
import WorkList from '../components/work/WorkList.astro';

const entries = (await getCollection('work')).sort(
	(a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf()
);
---

<Layout title="Work">
	<PageHeader>
		<h1>Portfolio</h1>
		<p>Check out the projects I've worked on!</p>
	</PageHeader>
	<WorkList entries={entries} />
</Layout>
